      "sourceTables": [
        {
          "name": "ods_base_official_customer_change_df",
          "isPrimary": true,
          "alias": "bocc"
        },
        {
          "name": "ods_base_official_customer_df",
          "isPrimary": false,
          "alias": "m",
          "joinType": "LEFT JOIN",
          "joinCondition": "bocc.OfficialCustomerID = m.OfficialCustomerID"
        },
        {
          "name": "ods_base_data_item_df",
          "isPrimary": false,
          "alias": "cl",
          "joinType": "LEFT JOIN",
          "joinCondition": "cl.DataItemID = bocc.CustomerLine -- CustomerLine name"
        },
        {
          "name": "ods_base_data_item_df",
          "isPrimary": false,
          "alias": "cata",
          "joinType": "LEFT JOIN",
          "joinCondition": "cata.DataItemID = bocc.CustomerLine AND cata.DICategoryID = 35 -- Category mapping"
        },
        {
          "name": "ods_base_data_item_df",
          "isPrimary": false,
          "alias": "catname",
          "joinType": "LEFT JOIN",
          "joinCondition": "catname.DataItemID = cata.Extendedproperty -- Category name"
        },
        {
          "name": "ods_base_data_item_df",
          "isPrimary": false,
          "alias": "hy",
          "joinType": "LEFT JOIN",
          "joinCondition": "hy.DataItemID = bocc.HYID -- HY line name"
        },
        {
          "name": "ods_base_data_item_df",
          "isPrimary": false,
          "alias": "hk",
          "joinType": "LEFT JOIN",
          "joinCondition": "hk.DataItemID = bocc.HKID -- HK line name"
        },
        {
          "name": "ods_base_data_item_df",
          "isPrimary": false,
          "alias": "ind",
          "joinType": "LEFT JOIN",
          "joinCondition": "ind.DataItemID = bocc.IndustryID -- Industry name"
        },
        {
          "name": "ods_base_org_df",
          "isPrimary": false,
          "alias": "org",
          "joinType": "LEFT JOIN",
          "joinCondition": "org.OrgID = bocc.OrgID -- Org name"
        },
        {
          "name": "ods_base_data_item_df",
          "isPrimary": false,
          "alias": "bf",
          "joinType": "LEFT JOIN",
          "joinCondition": "bf.DataItemID = bocc.BusinessField -- BusinessField name"
        },
        {
          "name": "ods_base_data_item_df",
          "isPrimary": false,
          "alias": "ct",
          "joinType": "LEFT JOIN",
          "joinCondition": "ct.DataItemID = bocc.CustomerType -- CustomerType name"
        }
      ],
      "advancedSql": {
        "type": "APPLY",
        "types": [
          "APPLY",
          "CTE"
        ],
        "applyContent": "OUTER APPLY (\n    SELECT TOP 1 wfp.ApprovalTime\n    FROM ods_wf_flow_progress_df wfp\n    WHERE wfp.FlowID = bocc.ChangeID\n      AND wfp.FlowTypeID = 1806\n    ORDER BY wfp.ApprovalTime DESC\n) wfp",
        "cteContent": "cust_cata AS (\n    SELECT DataItemID, Extendedproperty\n    FROM ods_base_data_item_df\n    WHERE DICategoryID = 35\n)",
        "cteAlias": "cust_cata",
        "customFromContent": ""
      }
