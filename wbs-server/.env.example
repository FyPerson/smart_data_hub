# ========== 应用配置 ==========
PORT=3000
LOG_LEVEL=INFO


# ========== 安全（生产部署必改） ==========
# JWT 签名密钥
# 生成方式: openssl rand -base64 32
JWT_SECRET=change_me_with_random_32bytes

# 数据库连接配置的对称加密密钥（32 字节）
# 生成方式: openssl rand -base64 32 | cut -c1-32
DB_ENCRYPTION_KEY=change_me_with_random_32bytes_!!


# ========== 钉钉企业内部应用（可选） ==========
# 数据协作模块的通知功能用，不填则跳过钉钉推送
# 凭证在管理后台 /admin.html 配置，会加密存储到 system_configs 表


# ========== API CLI 工具（可选） ==========
# scripts/api-call.js 使用
API_HOST=localhost
API_PORT=3000
API_USER=admin
API_PASSWORD=change_me_on_first_login
